{
  "name": "@ha-plus/ui",
  "version": "0.3.0",
  "description": "Home Assistant-native theme styles and accessible UI primitives for HA+",
  "type": "module",
  "license": "(MIT AND Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zvikarp/ha-plus-packages.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": "./src/index.js",
    "./mui": {
      "types": "./src/mui.d.ts",
      "default": "./src/mui.js"
    },
    "./ha-theme": {
      "types": "./src/ha-theme.d.ts",
      "default": "./src/ha-theme.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@mui/material": "^7.3.7"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "sideEffects": false,
  "bin": {
    "ha-plus-ui-licenses": "./src/copy-licenses.js"
  }
}
